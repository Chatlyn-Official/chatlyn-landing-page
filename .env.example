# Copy to .env.local for local testing. Production uses the defaults below, so no .env is needed there.
# Backend that stores contact form messages (POST /api/contact-submissions).
NEXT_PUBLIC_API_BASE_URL=https://api.chatlyn.in
# Where Log in / Sign up go (the WhatsApp app).
NEXT_PUBLIC_APP_URL=https://app.chatlyn.in
# This site's public address (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=https://chatlyn.in
